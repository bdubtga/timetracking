# Used instead of the root .dockerignore when building docker/coolify/Dockerfile.
# Unlike the root one, it keeps tailwind/postcss/tsconfig because the frontend is built inside Docker.
.git
**/.git
.gitmodules
.github
.DS_Store
.idea
.vscode
*.log

node_modules
extensions/*/node_modules
vendor
public/build
public/hot
public/storage

.env
.env.backup
auth.json

docs
e2e
tests
k8s
docker-compose.yml
docker/local
coverage
test-results
playwright-report
blob-report
playwright
playwright/.cache
.phpunit.cache
.phpunit.result.cache
_ide_helper.php
.phpstorm.meta.php

storage/logs/*
storage/*.key
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
